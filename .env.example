# ==========================================================================
# Vertex Digital — environment variables
#
# Copy this file to `.env.local` for local development, or configure the
# same keys in your hosting provider's dashboard (e.g. Vercel > Settings >
# Environment Variables) for production/preview deployments.
#
# Every value below is a PLACEHOLDER. Nothing in this file is a real
# credential. The site runs and the contact form fully works (validate,
# spam-check, store locally, log emails to the console) with NONE of these
# set — they upgrade specific pieces to production-grade infrastructure as
# each is configured. See README.md for full setup instructions for each.
# ==========================================================================

# --------------------------------------------------------------------------
# Site URL — used to build canonical URLs, sitemap.xml, robots.txt, and
# Open Graph metadata. Set this to your actual deployed domain in production.
# --------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --------------------------------------------------------------------------
# Database (contact + newsletter submissions)
#
# Without this set, submissions are appended to a local file at
# data/submissions.jsonl — fine for local development, but most serverless
# hosts (Vercel, etc.) have an ephemeral/read-only filesystem, so this MUST
# be set before deploying. Any standard Postgres provider works: Supabase,
# Neon, Railway, RDS, etc. Apply db/schema.sql once to your database first.
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Only needed if your Postgres provider uses a self-signed certificate and
# you understand the security tradeoff of disabling verification. Leave
# unset (or "true") in all normal cases.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --------------------------------------------------------------------------
# Email (Resend) — sends the internal lead-notification email and the
# client confirmation email.
#
# Without this set, emails are logged to the server console instead of
# sent — the form still works end-to-end, it just won't deliver real email.
# Sign up at https://resend.com, verify a sending domain, and create an API
# key.
# --------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain you've verified with Resend.
EMAIL_FROM=Vertex Digital <hello@your-verified-domain.com>

# --------------------------------------------------------------------------
# Rate limiting (Upstash Redis) — shares rate-limit state across every
# serverless instance, unlike the in-memory fallback used when this is unset.
# Recommended before launch if deploying to a serverless/multi-instance host.
# Create a free database at https://upstash.com and copy its REST credentials.
# --------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# --------------------------------------------------------------------------
# Analytics — optional, either or both. Unset = no analytics scripts load
# at all (zero extra network requests).
# --------------------------------------------------------------------------
# Google Analytics 4 measurement ID (Admin > Data Streams > your stream).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Plausible (privacy-friendly alternative) — just your site's domain.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
